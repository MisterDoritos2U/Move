<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Name="MainWindow"
    Title="XC Manager"
    Height="700"
    Width="1200"
    MinHeight="560"
    MinWidth="760"
    Style="{DynamicResource MaterialDesignWindow}"
    WindowStartupLocation="CenterScreen"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextElement.FontSize="14"
    TextElement.FontFamily="Roboto"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    WindowStyle = "None"
    AllowsTransparency = "true" 
    Background="Transparent"
    ResizeMode="CanResize"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
   >

    <Window.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.PopupBox.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.Orange.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Accent/MaterialDesignColor.Yellow.xaml" />
            </ResourceDictionary.MergedDictionaries>         
        </ResourceDictionary>  

    </Window.Resources>	  


    <Grid>

        <!-- Overlay layer -->  
        <Grid Panel.ZIndex="1000" Margin="6,0,6,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

                <!-- Open TreeView button-->
                <Grid Grid.Row="0" Height="40" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="0" Name="OpenTreeViewButton" HorizontalAlignment="Left" Style="{StaticResource MaterialDesignHamburgerToggleButton}" Width="30" Height="30" Margin="10,1,0,0" Foreground="Black"/> 
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,5,0">  
                        <Button Name="MinimizeButton" Height="30" Width="30" Margin="0" Padding="0" Background="Transparent" BorderThickness="0" Foreground="Black">                                                             
                            <materialDesign:PackIcon  VerticalAlignment="Center" HorizontalAlignment="Center"  Kind="WindowMinimize" Height="20" Width="20" Foreground="Black" />
                        </Button>
                        <Button Name="CloseAppButton" Height="30" Width="30" Margin="0" Padding="0" Background="Transparent" BorderThickness="0" Foreground="Black">
                            <materialDesign:PackIcon  VerticalAlignment="Center" HorizontalAlignment="Center" Kind="Close" Height="20" Width="20" Margin="0" />
                        </Button>
                    </StackPanel>
                </Grid>
          
                <!-- Snackbar -->            
                <materialDesign:Snackbar Name="Snackbar" Grid.Row="1" MessageQueue="{materialDesign:MessageQueue}" HorizontalAlignment="Stretch" Margin="10,0"/>
            
                <!-- Drawer Host 0: TREEVIEW -->
                <materialDesign:DrawerHost
                    IsLeftDrawerOpen = "False"
                    Name="DrawerHost0" 
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    OpenMode="Modal"
                    BorderThickness="0" 
                    LeftDrawerCornerRadius="17,0,0,17" 
                    LeftDrawerCloseOnClickAway="True"
                    ClipToBounds="True">

                    <!-- Left drawer TREEVIEW-->
                    <materialDesign:DrawerHost.LeftDrawerContent>  
                               
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            
                            <ToggleButton Name="CloseTreeViewButton" 
                                          Grid.Row="0" 
                                          Style="{StaticResource MaterialDesignHamburgerToggleButton}" 
                                          HorizontalAlignment="Right" 
                                          IsChecked="False" 
                                          Width="40" 
                                          Height="40" 
                                          Margin="0,0,10,0" 
                                          Command="{x:Static materialDesign:DrawerHost.CloseDrawerCommand}" 
                                          CommandParameter="{x:Static Dock.Left}"
                                          Foreground="Black"/>                                                                                               
                            
                            <StackPanel Grid.Row="1" Margin="10,5,0,10">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">

                                    <TextBox Name="SearchBox"  
                                             Margin="0,5,0,0" 
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                             materialDesign:TextFieldAssist.UnderlineBrush="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}" 
                                             materialDesign:HintAssist.Foreground="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}" 
                                             CaretBrush="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}"
                                             Width="275" 
                                             VerticalAlignment="Center" 
                                             VerticalContentAlignment="Center"
                                             materialDesign:TextFieldAssist.HasClearButton="True"
                                             materialDesign:HintAssist.Hint="Move VM or Plan">
                                    </TextBox>
                                    <Button Name="SearchIcon"  Background="Transparent" VerticalAlignment="Center" BorderThickness="0" Padding="0" Margin="5,0,0,0">
                                        <materialDesign:PackIcon Kind="Magnify" Height="25" Width="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>

                                </StackPanel>
                                <Border Name="TreeViewBorder" BorderThickness="5" BorderBrush="#FF202020" CornerRadius="5" MinWidth="300" Margin="0,20,10,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <TreeView Name="TreeView" Background="#202020" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0" IsTextSearchEnabled="True" IsTextSearchCaseSensitive="False" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" >       

                                            <TreeView.ContextMenu>
                                                <ContextMenu Name="ContextMenu">
                                                    <MenuItem Name="MenuIsm" Header="iSM" Visibility="Hidden">
                                                        <MenuItem Name="MenuIsmStart" Header="Start"/>
                                                        <MenuItem Name="MenuIsmStop" Header="Stop"/>
                                                        <MenuItem Name="MenuIsmRestart" Header="Restart"/>
                                                        <MenuItem Name="MenuIsmStatus" Header="Get Status"/>
                                                    </MenuItem>
                                                    <MenuItem Name="MenuPtAgent" Header="PTAgent" Visibility="Hidden">
                                                        <MenuItem Name="MenuPtAgentStart" Header="Start"/>
                                                        <MenuItem Name="MenuPtAgentStop" Header="Stop"/>
                                                        <MenuItem Name="MenuPtAgentRestart" Header="Restart"/>
                                                        <MenuItem Name="MenuPtAgentStatus" Header="Get Status"/>
                                                    </MenuItem>
                                                    <MenuItem Name="MenuNX" Header="NX">
                                                        <MenuItem Name="MenuResetNX" Header="Reset"/>
                                                        <MenuItem Name="MenuGetSel" Header="Get System Event Logs"/>
                                                    </MenuItem>
                                                    <Separator Style="{StaticResource MaterialDesignSeparator}" />
                                                    <MenuItem Header="Putty Session">
                                                        <MenuItem Name="MenuPuttyCluster" Header="Cluster"/>
                                                        <MenuItem Name="MenuPuttyHost" Header="Host"/>
                                                        <MenuItem Name="MenuPuttyCvm" Header="CVM"/>
                                                        <MenuItem Name="MenuPuttyNX" Header="NX"/>
                                                    </MenuItem>
                                                    <MenuItem Header="Open Browser">
                                                        <MenuItem Name="MenuBrowserPrism" Header="Prism"/>
                                                        <MenuItem Name="MenuBrowservCenter" Header="vCenter"/>
                                                        <MenuItem Name="MenuBrowserHost" Header="Host"/>
                                                        <MenuItem Name="MenuBrowserCvm" Header="CVM"/>
                                                        <MenuItem Name="MenuBrowserNX" Header="NX"/>
                                                    </MenuItem>
                                                    <MenuItem Header="Ping">
                                                        <MenuItem Name="MenuPingCluster" Header="Cluster"/>
                                                        <MenuItem Name="MenuPingHost" Header="Host"/>
                                                        <MenuItem Name="MenuPingCvm" Header="CVM"/>
                                                        <MenuItem Name="MenuPingNX" Header="NX"/>
                                                    </MenuItem>
                                                    <Separator Style="{StaticResource MaterialDesignSeparator}" />
                                                    <MenuItem Name="MenuInventoryCluster" Header="Inventory Cluster"/>
                                                    <Separator Style="{StaticResource MaterialDesignSeparator}" />
                                                    <MenuItem Name="MenuRemoveFromInventory" Header="Remove From Inventory"/>
                                                </ContextMenu>
                                            </TreeView.ContextMenu>
                                        
                                        
                                        </TreeView>
                                </Border>
                            </StackPanel>

                        </Grid>  
                                  
                    </materialDesign:DrawerHost.LeftDrawerContent>

                </materialDesign:DrawerHost>

                <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,20" HorizontalAlignment="Left" VerticalAlignment="Bottom" >

                    <!-- Progress Bar -->
                    <ProgressBar 
                        Name="ProgressBar"                         
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Bottom" 
                        IsIndeterminate="True" 
                        Style="{StaticResource MaterialDesignCircularProgressBar}" 
                        Foreground="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}"
                        Value="0" 
                        Margin="10,0,0,0"
                        Visibility="Hidden"/>

                    <CheckBox 
                        Name="CheckBoxTriggerSyncTreeView" 
                        HorizontalAlignment="Left"
                        Visibility="Hidden" 
                        Content="Main Thread Trigger" 
                        IsChecked="False" 
                        Margin="20,0,0,0" 
                        ToolTip="This checkbox is used to trigger stuff in the main thread." />

                        <CheckBox 
                        Name="CheckBoxTriggerUpdatePEListBox" 
                        HorizontalAlignment="Left"
                        Visibility="Hidden" 
                        Content="Main Thread Trigger" 
                        IsChecked="False" 
                        Margin="20,0,0,0" 
                        ToolTip="This checkbox is used to trigger stuff in the main thread." />

                </StackPanel>
        </Grid>
      
        <Border Name="MainWindowOutsideBorder" BorderThickness="1" CornerRadius="17"  Background="Transparent"> 
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{Binding Background, ElementName=TextBoxSelectedPrimaryColor, Path=Text}" Offset="0"/>
                    <GradientStop Color="{Binding Background, ElementName=TextBoxSelectedAccentColor, Path=Text}" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border Name="MainWindowInsideBorder" BorderThickness="5" CornerRadius="15" BorderBrush="Black" Background="{DynamicResource MaterialDesignPaper}">           
                <Grid>
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- Main menu -->
                        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    
                            <Border Name="MainMenuTopBorder" Background="#FF202020" Height="170" Width="700" CornerRadius="5" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40">

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">

                                        <Border Background="{DynamicResource MaterialDesignPaper}" Height="110" Width="135" CornerRadius="5" Margin="0,0,10,0">
                                            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="8">
                                                <Label HorizontalAlignment="Center">MOVE VMs</Label>
                                                <TextBlock Name="MoveVmsCount" HorizontalAlignment="Center" FontSize="50" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{DynamicResource MaterialDesignPaper}" Height="110" Width="135" CornerRadius="5" Margin="10,0,10,0">
                                            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="8">
                                                <Label HorizontalAlignment="Center">MIGRATION PLANS</Label>
                                                <TextBlock Name="MigrationPlansCount" HorizontalAlignment="Center" FontSize="50" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>

                                        
                                    </StackPanel>

                            </Border>
                            
                            <Border Name="MainMenuBottomBorder" Background="#FF202020" Height="Auto" MaxWidth="2000" CornerRadius="5" Margin="0,0,0,40" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                                <WrapPanel Height="Auto" HorizontalAlignment="Center">
                                    
                                    <Button Name="OpenInfoButton" Height="60" Width="90" Background="Transparent"  BorderThickness="0" Padding="0" Margin="5">
                                        <StackPanel>
                                            <materialDesign:PackIcon 
                                            Name="InfoIcon" 
                                            Kind="InformationOutline" 
                                            Height="40" 
                                            Width="40" 
                                            Margin="0" 
                                            HorizontalAlignment="Center"/>
                                            <Label Name="InfoLabel" HorizontalAlignment="Center">Info</Label>
                                        </StackPanel>
                                    </Button>

                                    <Button Name="OpenDiscoverButton" Height="60" Width="90" Background="Transparent"  BorderThickness="0" Padding="0" Margin="5">
                                        <StackPanel>
                                            <materialDesign:PackIcon Name="DiscoverIcon" Kind="Crosshairs" Height="40" Width="40" Margin="0" HorizontalAlignment="Center"/>
                                            <Label Name="DiscoverLabel" HorizontalAlignment="Center">Discover</Label>
                                        </StackPanel>
                                    </Button>

                                    <Button Name="OpenTasksButton" Height="60" Width="90" Background="Transparent"  BorderThickness="0" Padding="0" Margin="5">
                                        <StackPanel>
                                            <materialDesign:PackIcon Name="TasksIcon" Kind="FormatListChecks" Height="40" Width="40" Margin="0" HorizontalAlignment="Center"/>
                                            <Label Name="TasksLabel" HorizontalAlignment="Center">Tasks</Label>
                                        </StackPanel>
                                    </Button>

                                    <Button Name="OpenReportsButton" Height="60" Width="90" Background="Transparent"  BorderThickness="0" Padding="0" Margin="5">
                                        <StackPanel>
                                            <materialDesign:PackIcon Name="ReportsIcon" Kind="FileChartOutline" Height="40" Width="40" Margin="0" HorizontalAlignment="Center"/>
                                            <Label Name="ReportsLabel" HorizontalAlignment="Center">Reports</Label>
                                        </StackPanel>
                                    </Button>

                                    <Button Name="OpenMoveButton" Height="60" Width="90" Background="Transparent" BorderThickness="0" Padding="0" Margin="5" ToolTip="Open the Move VM inventory window">
                                        <StackPanel>
                                            <materialDesign:PackIcon Name="MoveIcon" Kind="TransitConnectionVariant" Height="40" Width="40" Margin="0" HorizontalAlignment="Center"/>
                                            <Label Name="MoveLabel" HorizontalAlignment="Center">Move</Label>
                                        </StackPanel>
                                    </Button>


                                    <Button Name="OpenOptionsButton" Height="60" Width="90" Background="Transparent"  BorderThickness="0" Padding="0" Margin="5">
                                        <StackPanel>
                                            <materialDesign:PackIcon Name="OptionsIcon" Kind="Cog" Height="40" Width="40" Margin="0" HorizontalAlignment="Center"/>
                                            <Label Name="OptionsLabel" HorizontalAlignment="Center">Options</Label>
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button Name="OpenThemeButton" Height="60" Width="90" Background="Transparent"  BorderThickness="0" Padding="0" Margin="5">
                                        <StackPanel>
                                            <materialDesign:PackIcon Name="ThemeIcon" Kind="Palette" Height="40" Width="40" Margin="0" HorizontalAlignment="Center"/>
                                            <Label Name="ThemeLabel" HorizontalAlignment="Center">Theme</Label>
                                        </StackPanel>
                                    </Button>

                                    <Button Name="OpenDebugButton" Height="60" Width="90" Background="Transparent" BorderThickness="0" Padding="0" Margin="5" ToolTip="Open application debug controls">
                                        <StackPanel>
                                            <materialDesign:PackIcon Name="DebugIcon" Kind="BugOutline" Height="40" Width="40" Margin="0" HorizontalAlignment="Center"/>
                                            <Label Name="DebugLabel" HorizontalAlignment="Center">Debug</Label>
                                        </StackPanel>
                                    </Button>

                                </WrapPanel>

                            </Border>

                        </StackPanel>

                        <!-- Drawer Host 1: INFO, DISCOVER, NOTES, OPTIONS-->
                        <materialDesign:DrawerHost
                            Name="DrawerHost1" 
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            OpenMode="Modal"
                            HorizontalAlignment="Stretch" 
                            BorderThickness="0" 
                            LeftDrawerCornerRadius="10,10,10,10" 
                            RightDrawerCornerRadius="0,10,10,0"
                            TopDrawerCornerRadius="10,10,10,10"
                            BottomDrawerCornerRadius="10,10,10,10"
                            RightDrawerCloseOnClickAway="True"
                            LeftDrawerCloseOnClickAway="True"
                            TopDrawerCloseOnClickAway="True"
                            BottomDrawerCloseOnClickAway="True"
                            ClipToBounds = "True"
                            >
                                            
                            <!-- Top drawer INFO -->
                            <materialDesign:DrawerHost.TopDrawerContent>                                    
                                <Grid Name="TopDrawerHost1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="50" />
                                    </Grid.RowDefinitions>
                                    
                                    <Grid Grid.Row="0" Margin="10,40,20,10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="140"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="30"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
    
                                        <Border Name="TopHostInfoBorder" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="#FF202020" MinWidth="850" CornerRadius="5" Margin="0,0,0,0" VerticalAlignment="Stretch">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBox Name="TextBoxHostName" FontWeight="Bold" FontSize="18" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="0" IsReadOnly="True" Margin="0,10,0,10" materialDesign:TextFieldAssist.UnderlineBrush="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Name="MiddleHostInfoBorder" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="#FF202020" MinWidth="850" CornerRadius="5" Margin="0,10,0,0" VerticalAlignment="Stretch">

                                            <Grid>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="220"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="5" Margin="10,10,0,10">
                                                        <StackPanel Margin="10">
                                                            <Label Content="Launch" FontWeight="Bold"/>
                                                            <ListBox Name="MoveLaunchListBox">
                                                                <ListBoxItem Name="MoveLaunchIpItem" Content="IP: No Move VM selected"/>
                                                            </ListBox>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Grid.Column="1" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="5" Margin="10,10,0,10">
                                                        <StackPanel Margin="10">
                                                            <Label Content="Move Info" FontWeight="Bold"/>
                                                            <TextBlock Name="MoveNtpServer" Text="NTP Server: Not available" Margin="0,4,0,0"/>
                                                            <TextBlock Name="MoveSnapshotConfiguration" Text="Snapshot Configuration: Not available" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                            <TextBlock Name="MoveVddkUpload" Text="VDDK Upload: Not available" Margin="0,4,0,0"/>
                                                            <TextBlock Name="MoveVersion" Text="Move Version: Not available" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Button Name="SupportBundleButton" Grid.Column="2" Content="Support Bundle" Height="40" Margin="10" VerticalAlignment="Top"/>
                                                </Grid>

                                            </Grid>

                                        </Border>



                                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="#FF202020" CornerRadius="5" Margin="0,10,0,0" Padding="10">
                                            <TextBox Name="TextBoxMoveVmJson" 
                                                     Text="Move VM JSON:" 
                                                     HorizontalAlignment="Stretch" 
                                                     VerticalAlignment="Stretch" 
                                                     IsReadOnly="True" 
                                                     BorderThickness="0" 
                                                     AcceptsReturn="True" 
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     materialDesign:TextFieldAssist.UnderlineBrush="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}"
                                                     Background="#FF202020" 
                                                     Foreground="White" 
                                                     MaxHeight="180"/>
                                        </Border>

                                        <TextBlock Name="TextBlockLastInventory" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Left" Foreground="#FF767676" FontSize="12" Margin="5,5,0,0">Host Inventory Completed On:</TextBlock>

                                    </Grid>
                                    
                                    <Button Name="CloseInfoButton" Grid.Row="1" Height="80" Width="80" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0" Command="{x:Static materialDesign:DrawerHost.CloseDrawerCommand}" CommandParameter="{x:Static Dock.Top}">
                                            <materialDesign:PackIcon Kind="ArrowLeft" Height="40" Width="40"  HorizontalAlignment="Center"/>
                                    </Button>

                                </Grid>                                       
                            </materialDesign:DrawerHost.TopDrawerContent>    

                            <!-- Bottom drawer DISCOVER -->
                            <materialDesign:DrawerHost.BottomDrawerContent>                                    
                                <Grid Name="BottomDrawerHost1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="80" />
                                    </Grid.RowDefinitions>

                                    <Border Name="DiscoverBorder" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#FF202020" CornerRadius="5" Padding="10,10,10,10" Margin="0,40,0,0" Height="560" Width="590" BorderBrush="Transparent">
                                    
                                            <StackPanel Orientation="Horizontal" Margin="20,0,20,0" HorizontalAlignment="Center" VerticalAlignment="Center">

                                                <StackPanel Margin="20,20,40,20">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10"> 
                                                        <TextBox Name="TextBoxPrismCentral" 
                                                                 Width="130"
                                                                 materialDesign:HintAssist.Hint="Move IP"  
                                                                 materialDesign:TextFieldAssist.UnderlineBrush="{Binding Color, ElementName=TextBoxSelectedAccentColor, Path=Text}"
                                                                 ToolTip="Enter one or more Move IPv4 addresses and press 'enter' to add them to the list." />
                                                        <materialDesign:PopupBox
                                                            Name="PCPopupBox"
                                                            Height="30"
                                                            Width="30" 
                                                            StaysOpen="False" 
                                                            Style="{StaticResource MaterialDesignMultiFloatingActionPopupBox}" 
                                                            PlacementMode="BottomAndAlignCentres" 
                                                            Margin="10,0,0,0" 
                                                            ToolTipService.Placement="Top" 
                                                            ToolTip="Actions" 
                                                            BorderBrush="{Binding Text, ElementName=TextBoxSelectedPrimaryColor, UpdateSourceTrigger=PropertyChanged}" 
                                                            Background="{Binding Text, ElementName=TextBoxSelectedPrimaryColor, UpdateSourceTrigger=PropertyChanged}">
                                                                    <Border CornerRadius="5" BorderBrush="{DynamicResource MaterialDesignPaper}" BorderThickness="1" Background="{DynamicResource MaterialDesignPaper}">
                                                                        <ListBox Name="PCPopupBoxValues" Background="{DynamicResource MaterialDesignPaper}">
                                                                            <TextBlock Name="PCAdd" Text="Add"/>
                                                                            <TextBlock Name="PCImport" Text="Import List"/>
                                                                        </ListBox>
                                                                    </Border>

                                                        </materialDesign:PopupBox>
                                                    </StackPanel>
                                                    <ListBox Name="ListBoxPrismCentral"
                                                            Height="380" 
                                                            Width="170" 
                                                            Padding="2,2,2,2" 
                                                            Background="{DynamicResource MaterialDesignPaper}" 
                                                            BorderThickness="0" 
                                                            SelectionMode="Extended" 
                                                            ToolTip="Accepts ctrl+click and shift+click. To delete from list, select one or more items and press 'delete'.">

                                                        <ListBox.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="5"/>
                                                            </Style>        
                                                        </ListBox.Resources>


                                                    </ListBox>
                                                    <Button Name="ButtonInventoryPCList" Width="130" Content="Get Move VMs" Margin="0,20,0,10"/>
                                                </StackPanel>

                                                            
                                            </StackPanel>

                                    </Border>

                                    <Button Name="CloseDiscoverButton" Grid.Row="1" Height="80" Width="80" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0" Command="{x:Static materialDesign:DrawerHost.CloseDrawerCommand}" CommandParameter="{x:Static Dock.Bottom}">
                                            <materialDesign:PackIcon Kind="ArrowLeft" Height="40" Width="40"  HorizontalAlignment="Center"/>
                                    </Button>

                                </Grid>                                       
                            </materialDesign:DrawerHost.BottomDrawerContent>   

                            <!-- Left drawer NOTES -->
                            <materialDesign:DrawerHost.LeftDrawerContent>                                    
                                <Grid Name="LeftDrawerHost1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="80" />
                                    </Grid.RowDefinitions>

                                    <Border Name="NotesBorder" Grid.Row="0" BorderThickness="0" CornerRadius="5" Background="#FF202020" Height="560" Width="800" Margin="10,40,20,10" VerticalAlignment="Top" HorizontalAlignment="Center">
                                            <TextBox Name="TextBoxNotes" 
                                                         Grid.Row = "0" 
                                                         AcceptsReturn="True" 
                                                         AcceptsTab="True"
                                                         SpellCheck.IsEnabled="True" 
                                                         IsReadOnly="False"
                                                         Padding="10"
                                                         materialDesign:TextFieldAssist.UnderlineBrush="{x:Null}"
                                                         materialDesign:HintAssist.Foreground="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}"
                                                         materialDesign:TextFieldAssist.DecorationVisibility="Hidden" 
                                                         CaretBrush="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}"
                                                         VerticalScrollBarVisibility="Auto"
                                                         materialDesign:HintAssist.Hint="Save notes here."
                                                         
                                            />
                                    </Border>                                            

                                    <Button Name="CloseNotesButton" Grid.Row="1" Height="80" Width="80" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Margin="0" Command="{x:Static materialDesign:DrawerHost.CloseDrawerCommand}" CommandParameter="{x:Static Dock.Left}">
                                            <materialDesign:PackIcon Kind="ArrowLeft" Height="40" Width="40" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button >

                                    

                                </Grid>                                       
                            </materialDesign:DrawerHost.LeftDrawerContent>  

                            <!-- Right drawer OPTIONS-->
                            <materialDesign:DrawerHost.RightDrawerContent>                                    
                                <Grid Width="330" Name="RightDrawerHost1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    
                                    <Button Name="CloseOptionsButton" Grid.Row="0" Height="60" Width="60" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Margin="0" Command="{x:Static materialDesign:DrawerHost.CloseDrawerCommand}" CommandParameter="{x:Static Dock.Right}">
                                            <materialDesign:PackIcon Kind="Close" Height="40" Width="40" Margin="0" HorizontalAlignment="Center"/>
                                    </Button >

                                    <StackPanel Grid.Row="1">
                                        <Border Name="SavedCredentialsBorder" Background="#FF202020" CornerRadius="5" Padding="10,10,10,10" Margin="10,10,10,10" Height="330" Width="310" VerticalAlignment="Top" BorderBrush="Transparent">

                                            <StackPanel>
                                                <Label Content="Saved Credentials" Margin="0,0,0,10" />
                                                <CheckBox Name="CheckBoxSaveMoveCreds" Content="Move" IsChecked="False" Margin="0,0,0,10" ToolTip="Click to save or remove credentials. They are removed at application close." />
                                                <CheckBox Name="CheckBoxSaveServiceAccountCreds" Content="Service Account" IsChecked="False" Margin="0,0,0,10" ToolTip="Click to save or remove credentials. They are removed at application close." />
                                                <CheckBox Name="CheckBoxSavePrismCentralCreds" Content="Prism Central" IsChecked="False" Margin="0,0,0,10" ToolTip="Click to save or remove credentials. They are removed at application close." />
                                                <CheckBox Name="CheckBoxSavePrismElementCreds" Content="Prism Element" IsChecked="False" Margin="0,0,0,10" ToolTip="Click to save or remove credentials. They are removed at application close." />
                                                <CheckBox Name="CheckBoxSavevCenterCreds" Content="vCenter" IsChecked="False" Margin="0,0,0,10" ToolTip="Click to save or remove credentials. They are removed at application close." />
                                                <Separator Margin="0,10,0,10" />
                                                <CheckBox Name="CheckBoxUseSavedCredentials" IsChecked="False" Margin="0,0,0,10" ToolTip="Don't prompt for credentials if they are saved." Content="Use Saved Credentials" />
                                                <TextBlock TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Text="Not using saved credentials could result in a large amount of credential requests." />
                                                <TextBlock TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Text="All credentials are erased from memory during application close." />
                                            </StackPanel>
                                        </Border>


                                        <Border Name="ConsoleVisibilityBorder" Background="#FF202020" CornerRadius="5" Grid.Row="1" Padding="10,10,10,10" Margin="10,10,10,10" Height="80" Width="310" VerticalAlignment="Top" BorderBrush="Transparent">
                                            <Grid>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                    <Label Content="Console Visibility" Margin="0,0,0,10" />
                                                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                                        <TextBlock VerticalAlignment="Center" Margin="0,0,5,0">Off</TextBlock>
                                                        <ToggleButton Name="ConsoleVisibilityToggle" IsChecked="False" Margin="0" ToolTip="Show or hide the console." />
                                                        <TextBlock VerticalAlignment="Center" Margin="5,0,0,0">On</TextBlock>
                                                    </StackPanel>                                                                                            
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                    <Label Content="Sync with Server" Margin="0,0,0,10" />
                                                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                                        <TextBlock VerticalAlignment="Center" Margin="0,0,5,0">Off</TextBlock>
                                                        <ToggleButton Name="SyncToggle" IsChecked="True" Margin="0" ToolTip="Sync data with that on the server." />
                                                        <TextBlock VerticalAlignment="Center" Margin="5,0,0,0">On</TextBlock>
                                                    </StackPanel>                                                                                            
                                                </StackPanel>



                                            </Grid>
                                        </Border>



                                        <Border Name="MaxTasksBorder" Background="#FF202020" CornerRadius="5" Grid.Row="1" Padding="10,10,10,10" Margin="10,10,10,10" Height="120" Width="310" VerticalAlignment="Top" BorderBrush="Transparent">

                                            <StackPanel>
                                                <TextBlock Margin="0,0,0,10">Max Concurrent Tasks</TextBlock>
                                                <Slider Name="Slider"
                                                        Maximum="20"
                                                        Minimum="1"
                                                        Style="{StaticResource MaterialDesignDiscreteSlider}"
                                                        TickFrequency="{Binding DiscreteHorizontal.TickFrequency}"
                                                        TickPlacement="BottomRight"
                                                        Value="5"
                                                        Foreground="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                                            <TextBlock VerticalAlignment="Center" Margin="0,3,0,0">Reset Task Settings:</TextBlock>
                                                            <Button Name="ResetTasksButton" Background="Transparent" BorderThickness="0" Height="27" Width="27" Margin="10,0,0,0" Padding="0" VerticalAlignment="Top">
                                                                <materialDesign:PackIcon Name="ResetTasksIcon" Kind="BackupRestore" Height="27" Width="27" VerticalAlignment="Center" />
                                                            </Button>
                                                        </StackPanel>
                                            </StackPanel>

                                        </Border>

                                    </StackPanel>
                                </Grid>                                       
                            </materialDesign:DrawerHost.RightDrawerContent>             

                        </materialDesign:DrawerHost>

                        <!-- Drawer Host 2: DEVICES, NX Logs, TASKS, THEME -->
                        <materialDesign:DrawerHost
                            Name="DrawerHost2" 
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            OpenMode="Modal" 
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch" 
                            BorderThickness="0" 
                            LeftDrawerCornerRadius="10,10,10,10" 
                            RightDrawerCornerRadius="10,10,10,10"
                            TopDrawerCornerRadius="10,10,10,10"
                            BottomDrawerCornerRadius="10,10,10,10"
                            ClipToBounds="True"
                            >
                    
                            <!-- Left drawer DEVICES -->
                            <materialDesign:DrawerHost.LeftDrawerContent>                                    
                                <Grid Name="LeftDrawerHost2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="80" />
                                    </Grid.RowDefinitions>
                                
                                    <Border Name="DevicesBorder" Grid.Row="0" BorderThickness="0" CornerRadius="5" Background="#FF202020" Height="560" Width="700" Margin="10,40,20,10" VerticalAlignment="Top" HorizontalAlignment="Center">

                                            <ListView Name="ListViewFirmware" HorizontalAlignment="Stretch" VerticalAlignment="Top" BorderBrush="{x:Null}">
                                                <ListView.View>
                                                    <GridView>
                                                        <GridViewColumn Width="460" Header="Device Description" DisplayMemberBinding="{Binding Description}"/>
                                                        <GridViewColumn Width="150" Header="Version" DisplayMemberBinding="{Binding Version}"/>
                                                    </GridView>
                                                </ListView.View>          
                                            </ListView>

                                    </Border>

                                    <Button Name="CloseDevicesButton" Grid.Row="1" Height="80" Width="80" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Margin="0" Command="{x:Static materialDesign:DrawerHost.CloseDrawerCommand}" CommandParameter="{x:Static Dock.Left}">
                                            <materialDesign:PackIcon Kind="ArrowLeft" Height="40" Width="40" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button >

                                </Grid>                                       
                            </materialDesign:DrawerHost.LeftDrawerContent>                        

                            <!-- Right drawer NX LOGS -->
                            <materialDesign:DrawerHost.RightDrawerContent>                                    
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="80" />
                                    </Grid.RowDefinitions>
                                
                                    <Border Name="LogsBorder" Grid.Row="0" BorderThickness="0" CornerRadius="5" Background="#FF202020" Height="560" Width="1150" Margin="10,40,20,10" VerticalAlignment="Top" HorizontalAlignment="Center">
                                            <ListView Name="ListViewNXLogs" HorizontalAlignment="Stretch" VerticalAlignment="Top" BorderBrush="{x:Null}">
                                                <ListView.View>
                                                    <GridView>
                                                        <GridViewColumn Width="150" Header="Date" DisplayMemberBinding="{Binding Date}"/>
                                                        <GridViewColumn Width="150" Header="Severity" DisplayMemberBinding="{Binding Severity}"/>
                                                        <GridViewColumn Width="700" Header="Description" DisplayMemberBinding="{Binding Description}"/>
                                                    </GridView>
                                                </ListView.View>          
                                            </ListView>
                                    </Border>

                                    <Button Name="CloseLogsButton" Grid.Row="1" Height="80" Width="80" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Margin="0" Command="{x:Static materialDesign:DrawerHost.CloseDrawerCommand}" CommandParameter="{x:Static Dock.Right}">
                                            <materialDesign:PackIcon Kind="ArrowLeft" Height="40" Width="40" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button >

                                </Grid>                                       
                            </materialDesign:DrawerHost.RightDrawerContent>   

                            <!-- Top drawer TASKS -->
                            <materialDesign:DrawerHost.TopDrawerContent>                                    
                                <Grid Name="TopDrawerHost2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="80" />
                                    </Grid.RowDefinitions>
                                
                                    <Border Name="TasksBorder" Grid.Row="0" BorderThickness="0" CornerRadius="5,5,5,5" Background="#FF202020" Height="560" Width="1150" Margin="10,40,20,10" VerticalAlignment="Top" HorizontalAlignment="Center">
                                            <ListView Name="ListViewTasks" HorizontalAlignment="Stretch" VerticalAlignment="Top" BorderBrush="{x:Null}" >
                                                <ListView.View>
                                                    <GridView>
                                                        <GridViewColumn Header="Task ID" Width="115" DisplayMemberBinding="{Binding TaskID}" />     
                                                        <GridViewColumn Header="Start Time" Width="135" DisplayMemberBinding="{Binding StartTime}"/>
                                                        <GridViewColumn Header="Target" Width="150" DisplayMemberBinding="{Binding Target}"/>
                                                        <GridViewColumn Header="Details" Width="450">
                                                            <GridViewColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Width="440" Text="{Binding Details}" TextWrapping="Wrap" ToolTip="{Binding Details}" />
                                                                </DataTemplate>
                                                            </GridViewColumn.CellTemplate>
                                                        </GridViewColumn>
                                                        <GridViewColumn Header="Status" Width="100" DisplayMemberBinding="{Binding Status}"/>
                                                        <GridViewColumn Header="End Time" Width="135" DisplayMemberBinding="{Binding CompletionTime}"/>
                                                    </GridView>
                                                </ListView.View>          
                                            </ListView>
                                    </Border>

                                    <Button Name="CloseTasksButton" Grid.Row="1" Height="80" Width="80" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Margin="0" Command="{x:Static materialDesign:DrawerHost.CloseDrawerCommand}" CommandParameter="{x:Static Dock.Top}">
                                            <materialDesign:PackIcon Kind="Arrowleft" Height="40" Width="40" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button >

                                </Grid>                                       
                            </materialDesign:DrawerHost.TopDrawerContent> 

                            <!-- Bottom drawer THEME -->
                            <materialDesign:DrawerHost.BottomDrawerContent>
                                <Grid Height="100" Name="BottomDrawerHost2" Margin="0" >

                                    <Button Name="CloseThemeButton" Height="80" Width="80" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,0" Command="{x:Static materialDesign:DrawerHost.CloseDrawerCommand}" CommandParameter="{x:Static Dock.Bottom}">
                                        <materialDesign:PackIcon Kind="ArrowLeft" Height="40" Width="40" Margin="20,28,0,0" HorizontalAlignment="Center"/>
                                    </Button>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock VerticalAlignment="Center" Margin="0,0,5,0">Light</TextBlock>
                                            <ToggleButton Name="ThemeToggleButton" />
                                            <TextBlock VerticalAlignment="Center" Margin="5,0,0,0">Dark</TextBlock>

                                            <materialDesign:PopupBox x:Name="ChangePrimaryColorPopupBox" 
                                                                    StaysOpen="True" 
                                                                    Style="{StaticResource MaterialDesignMultiFloatingActionPopupBox}" 
                                                                    PlacementMode="TopAndAlignCentres" 
                                                                    Margin="40,0,0,0" 
                                                                    ToolTipService.Placement="Top" 
                                                                    ToolTip="Primary Color" 
                                                                    HorizontalAlignment="Right"
                                                                    BorderBrush="{Binding Text, ElementName=TextBoxSelectedPrimaryColor, UpdateSourceTrigger=PropertyChanged}" 
                                                                    Background="{Binding Text, ElementName=TextBoxSelectedPrimaryColor, UpdateSourceTrigger=PropertyChanged}">
                                                <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Width="500" Height="200" Margin="0" >
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="50"/>
                                                        <RowDefinition />
                                                    </Grid.RowDefinitions>
                                                    <TextBox x:Name="TextBoxSelectedPrimaryColor" 
                                                            Grid.Row="0" 
                                                            Margin="0" 
                                                            IsReadOnly="True"
                                                            materialDesign:HintAssist.Hint="Color HEX value" 
                                                            HorizontalAlignment="Stretch" 
                                                            VerticalAlignment="Stretch" 
                                                            HorizontalContentAlignment="Center" 
                                                            Style="{StaticResource MaterialDesignFilledTextBox}"
                                                            Text="{Binding Color, ElementName=PrimaryColorPicker, UpdateSourceTrigger=PropertyChanged}"
                                                            Background="{Binding Text, ElementName=TextBoxSelectedPrimaryColor, UpdateSourceTrigger=PropertyChanged}"
                                                            materialDesign:TextFieldAssist.UnderlineBrush="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}" 
                                                            materialDesign:HintAssist.Foreground="Black"/>
                                                    <materialDesign:ColorPicker x:Name="PrimaryColorPicker" Grid.Row="1" Color="{Binding SelectedColor, Delay=25, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                                </Grid>                                    
                                            </materialDesign:PopupBox>

                                            <materialDesign:PopupBox Name="ChangeAccentColorPopupBox" 
                                                                    StaysOpen="True" 
                                                                    Style="{StaticResource MaterialDesignMultiFloatingActionAccentPopupBox}" 
                                                                    PlacementMode="TopAndAlignCentres" 
                                                                    Margin="10,0,0,0" 
                                                                    ToolTipService.Placement="Top" 
                                                                    ToolTip="Accent Color" 
                                                                    BorderBrush="{Binding Text, ElementName=TextBoxSelectedAccentColor, UpdateSourceTrigger=PropertyChanged}" 
                                                                    Background="{Binding Text, ElementName=TextBoxSelectedAccentColor, UpdateSourceTrigger=PropertyChanged}">
                                                <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Width="500" Height="200" Margin="0" >
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="50"/>
                                                        <RowDefinition />
                                                    </Grid.RowDefinitions>
                                                    <TextBox Name="TextBoxSelectedAccentColor" 
                                                            Grid.Row="0" 
                                                            Margin="0" 
                                                            IsReadOnly="True"
                                                            materialDesign:HintAssist.Hint="Color HEX value" 
                                                            HorizontalAlignment="Stretch" 
                                                            VerticalAlignment="Stretch" 
                                                            HorizontalContentAlignment="Center" 
                                                            Style="{StaticResource MaterialDesignFilledTextBox}"
                                                            Text="{Binding Color, ElementName=AccentColorPicker, UpdateSourceTrigger=PropertyChanged}"
                                                            Background="{Binding Text, ElementName=TextBoxSelectedAccentColor, UpdateSourceTrigger=PropertyChanged}"
                                                            materialDesign:TextFieldAssist.UnderlineBrush="{Binding Color, ElementName=TextBoxSelectedAccentColor, Path=Text}" 
                                                            materialDesign:HintAssist.Foreground="Black"/>
                                                    <materialDesign:ColorPicker x:Name="AccentColorPicker" Grid.Row="1" Color="{Binding SelectedColor, Delay=25, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                                </Grid>     
                                            </materialDesign:PopupBox>

                                    </StackPanel>
                                </Grid>
                            </materialDesign:DrawerHost.BottomDrawerContent> 


                        </materialDesign:DrawerHost>

                        <!-- Drawer Host 3: CONTACTS, ALERTS -->
                        <materialDesign:DrawerHost
                            Name="DrawerHost3" 
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            OpenMode="Modal" 
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch" 
                            BorderThickness="0" 
                            LeftDrawerCornerRadius="10,10,10,10" 
                            RightDrawerCornerRadius="10,10,10,10"
                            TopDrawerCornerRadius="10,10,10,10"
                            BottomDrawerCornerRadius="10,10,10,10"
                            ClipToBounds="True"
                            Opacity="1"
                            >

                            <!-- Left drawer CONTACTS -->
                            <materialDesign:DrawerHost.LeftDrawerContent>                                    
                                <Grid Name="LeftDrawerHost3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="80" />
                                    </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Width="830" Margin="10,40,20,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="30" />
                                            </Grid.RowDefinitions>
                                            <Border Name="ContactsBorder" Grid.Row="0" BorderThickness="0" CornerRadius="5" Background="#FF202020" Width="800" VerticalAlignment="Top" HorizontalAlignment="Center">
                                                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <TextBox Name="FacilityName" FontWeight="Bold" FontSize="18" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="0" IsReadOnly="False" Margin="0,10,0,10" materialDesign:TextFieldAssist.UnderlineBrush="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}" materialDesign:HintAssist.Hint="Facility Name"/>  
                                                    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition />
                                                            <RowDefinition />
                                                            <RowDefinition />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition />
                                                            <ColumnDefinition />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="5" Margin="10,0,10,10" HorizontalAlignment="Stretch">
                                                            <StackPanel>                                                            
                                                                <Grid Margin="10,10,0,0">
                                                                    <Label Name="PrimaryContact" Margin="0,0,0,5" Content="Primary Contact" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,10,0">
                                                                        <Button Name="CopyPrimaryContactButton" BorderThickness="0" Background="Transparent" Margin="0,0,5,0" Padding="0" Height="25" Width="25" VerticalAlignment="Top" ToolTip="Copy primary contact to clipboard.">
                                                                            <materialDesign:PackIcon Name="CopyPrimaryContactIcon" Kind="ClipboardArrowDownOutline" VerticalAlignment="Center" Height="28" Width="25"/>
                                                                        </Button>
                                                                        <materialDesign:PackIcon Name="PrimaryContactIcon" Kind="CardAccountMail" Height="23" Width="23" />
                                                                    </StackPanel>
                                                                </Grid>
                                                                <StackPanel>

                                                                    <TextBox Name="PrimaryContactName" HorizontalAlignment="Stretch" IsReadOnly="False" BorderThickness="0" Margin="10,0,10,5" materialDesign:TextFieldAssist.UnderlineBrush="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}" materialDesign:HintAssist.Hint="Name"/>
                                                                    <TextBox Name="PrimaryContactPhone" HorizontalAlignment="Stretch" IsReadOnly="False" BorderThickness="0" Margin="10,0,10,5" materialDesign:TextFieldAssist.UnderlineBrush="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}" materialDesign:HintAssist.Hint="Phone Number"/>
                                                                    <TextBox Name="PrimaryContactEmail" HorizontalAlignment="Stretch" IsReadOnly="False" BorderThickness="0" Margin="10,0,10,5" materialDesign:TextFieldAssist.UnderlineBrush="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}" materialDesign:HintAssist.Hint="Email Address"/>
                                                                    <TextBox Name="PrimaryContactTitle" HorizontalAlignment="Stretch" IsReadOnly="False" BorderThickness="0" Margin="10,0,10,10" materialDesign:TextFieldAssist.UnderlineBrush="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}" materialDesign:HintAssist.Hint="Title"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>

                                                        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="5" Margin="0,0,10,10" HorizontalAlignment="Stretch">
                                                            <StackPanel>                                                            
                                                                <Grid Margin="10,10,0,0">
                                                                    <Label Name="SecondaryContact" Margin="0,0,0,5" Content="Secondary Contact" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,10,0">
                                                                        <Button Name="CopySecondaryContactButton" BorderThickness="0" Background="Transparent" Margin="0,0,5,0" Padding="0" Height="25" Width="25" VerticalAlignment="Top" ToolTip="Copy secondary contact to clipboard.">
                                                                            <materialDesign:PackIcon Name="CopySecondaryContactIcon" Kind="ClipboardArrowDownOutline" VerticalAlignment="Center" Height="28" Width="25"/>
                                                                        </Button>
                                                                        <materialDesign:PackIcon Name="SecondaryContactIcon" Kind="CardAccountMail" Height="23" Width="23" />
                                                                    </StackPanel>
                                                                    
                                                                </Grid>
                                                                <StackPanel>

                                                                    <TextBox Name="SecondaryContactName" HorizontalAlignment="Stretch" IsReadOnly="False" BorderThickness="0" Margin="10,0,10,5" materialDesign:TextFieldAssist.UnderlineBrush="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}" materialDesign:HintAssist.Hint="Name"/>
                                                                    <TextBox Name="SecondaryContactPhone" HorizontalAlignment="Stretch" IsReadOnly="False" BorderThickness="0" Margin="10,0,10,5" materialDesign:TextFieldAssist.UnderlineBrush="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}" materialDesign:HintAssist.Hint="Phone Number"/>
                                                                    <TextBox Name="SecondaryContactEmail" HorizontalAlignment="Stretch" IsReadOnly="False" BorderThickness="0" Margin="10,0,10,5" materialDesign:TextFieldAssist.UnderlineBrush="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}" materialDesign:HintAssist.Hint="Email Address"/>
                                                                    <TextBox Name="SecondaryContactTitle" HorizontalAlignment="Stretch" IsReadOnly="False" BorderThickness="0" Margin="10,0,10,10" materialDesign:TextFieldAssist.UnderlineBrush="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}" materialDesign:HintAssist.Hint="Title"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>

                                                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="5" Margin="10,0,10,10" HorizontalAlignment="Stretch">
                                                            <StackPanel>                                                            
                                                                <Grid Margin="10,10,0,0">
                                                                    <Label Name="GroupContact" Margin="0,0,0,5" Content="Group Contact" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,10,0">
                                                                        <Button Name="CopyGroupContactButton" BorderThickness="0" Background="Transparent" Margin="0,0,5,0" Padding="0" Height="25" Width="25" VerticalAlignment="Top" ToolTip="Copy group contact to clipboard.">
                                                                            <materialDesign:PackIcon Name="CopyGroupContactIcon" Kind="ClipboardArrowDownOutline" VerticalAlignment="Center" Height="28" Width="25"/>
                                                                        </Button>
                                                                        <materialDesign:PackIcon Name="GroupContactIcon" Kind="AccountGroup" Height="23" Width="23" />
                                                                    </StackPanel>
                                                                </Grid>
                                                                <StackPanel>
                                                                    <TextBox Name="GroupContactName" HorizontalAlignment="Stretch" IsReadOnly="False" BorderThickness="0" Margin="10,0,10,5" materialDesign:TextFieldAssist.UnderlineBrush="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}" materialDesign:HintAssist.Hint="Name"/>
                                                                    <TextBox Name="GroupContactPhone" HorizontalAlignment="Stretch" IsReadOnly="False" BorderThickness="0" Margin="10,0,10,5" materialDesign:TextFieldAssist.UnderlineBrush="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}" materialDesign:HintAssist.Hint="Phone Number"/>
                                                                    <TextBox Name="GroupContactEmail" HorizontalAlignment="Stretch" IsReadOnly="False" BorderThickness="0" Margin="10,0,10,10" materialDesign:TextFieldAssist.UnderlineBrush="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}" materialDesign:HintAssist.Hint="Email Address"/> </StackPanel>
                                                            </StackPanel>
                                                        </Border>

                                                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="5" Margin="10,0,10,10" HorizontalAlignment="Stretch">
                                                            <StackPanel>                                                            
                                                                <Grid Margin="10,10,0,0">
                                                                    <Label Content="Shipping Address" Margin="0,0,0,5" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,10,0">
                                                                        <Button Name="CopyAddressButton" BorderThickness="0" Background="Transparent" Margin="0,0,5,0" Padding="0" Height="25" Width="25" VerticalAlignment="Top" ToolTip="Copy address to clipboard.">
                                                                            <materialDesign:PackIcon Name="CopyAddressIcon" Kind="ClipboardArrowDownOutline" VerticalAlignment="Center" Height="28" Width="25"/>
                                                                        </Button>
                                                                        <materialDesign:PackIcon Name="AddressIcon" Kind="Mail" Height="23" Width="23" />
                                                                    </StackPanel>
                                                                </Grid>
                                                                <StackPanel>
                                                                    <TextBox Name="Street" HorizontalAlignment="Stretch" IsReadOnly="False" BorderThickness="0" Margin="10,0,10,5" materialDesign:TextFieldAssist.UnderlineBrush="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}" materialDesign:HintAssist.Hint="Street"/>
                                                                    <TextBox Name="City" HorizontalAlignment="Stretch" IsReadOnly="False" BorderThickness="0" Margin="10,0,10,5" materialDesign:TextFieldAssist.UnderlineBrush="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}" materialDesign:HintAssist.Hint="City"/>
                                                                    <TextBox Name="State" HorizontalAlignment="Stretch" IsReadOnly="False" BorderThickness="0" Margin="10,0,10,5" materialDesign:TextFieldAssist.UnderlineBrush="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}" materialDesign:HintAssist.Hint="State"/>
                                                                    <TextBox Name="Zip" HorizontalAlignment="Stretch" IsReadOnly="False" BorderThickness="0" Margin="10,0,10,10" materialDesign:TextFieldAssist.UnderlineBrush="{Binding Color, ElementName=TextBoxSelectedPrimaryColor, Path=Text}" materialDesign:HintAssist.Hint="Zip"/>  
                                                                    
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>

                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Button Name="SaveContactsButton" Grid.Row="1" BorderThickness="0" Background="Transparent" Margin="0,10,20,0" Padding="0" Height="30" Width="30" VerticalAlignment="Center" HorizontalAlignment="Right" ToolTip="Save contact info.">
                                                    <materialDesign:PackIcon Name="SaveContactsIcon" Kind="ContentSaveOutline" VerticalAlignment="Center" Height="30" Width="30"/>
                                            </Button>
                                        </Grid>
                                    
                                    <Button Name="CloseContactsButton" Grid.Row="1" Height="80" Width="80" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Margin="0" Command="{x:Static materialDesign:DrawerHost.CloseDrawerCommand}" CommandParameter="{x:Static Dock.Left}">
                                            <materialDesign:PackIcon Kind="ArrowLeft" Height="40" Width="40" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button >

                                </Grid>                                       
                            </materialDesign:DrawerHost.LeftDrawerContent> 

                            <!-- Right drawer DEBUG -->
                            <materialDesign:DrawerHost.RightDrawerContent>
                                <Grid Width="420" Name="RightDrawerHost3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Button Name="CloseDebugButton" Grid.Row="0" Height="60" Width="60" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Margin="0" Command="{x:Static materialDesign:DrawerHost.CloseDrawerCommand}" CommandParameter="{x:Static Dock.Right}">
                                        <materialDesign:PackIcon Kind="Close" Height="40" Width="40" Margin="0" HorizontalAlignment="Center"/>
                                    </Button>

                                    <StackPanel Grid.Row="1">
                                        <Border Name="DebugBorder" Background="#FF202020" CornerRadius="5" Padding="16" Margin="10" VerticalAlignment="Top">
                                            <StackPanel>
                                                <TextBlock Text="Application Debug" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Capture diagnostic output" VerticalAlignment="Center" />
                                                    <ToggleButton Name="DebugToggleButton" IsChecked="False" Margin="20,0,0,0" ToolTip="Start or stop application diagnostics." />
                                                </StackPanel>
                                                <TextBlock Name="DebugStatusText" Text="Debugging is off" Margin="0,16,0,6" />
                                                <TextBox Name="DebugLogPathText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                                    <Button Name="OpenDebugLogButton" Content="Open Log Folder" Margin="0,0,8,0" Padding="12,6" />
                                                    <Button Name="ClearDebugLogButton" Content="Clear Log" Padding="12,6" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </materialDesign:DrawerHost.RightDrawerContent>

                        </materialDesign:DrawerHost>


                    </Grid>
                </Grid>
            </Border>
        </Border> 

    </Grid>
</Window>