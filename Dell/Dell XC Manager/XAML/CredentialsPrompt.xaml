<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Credentials Request"
    Width="355"
    Height="325"  
    WindowStyle = "None"
    AllowsTransparency = "true" 
    Background="Transparent"
    WindowStartupLocation="CenterScreen"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextElement.FontSize="14"
    TextElement.FontFamily="Roboto"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
        >

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.PopupBox.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.Orange.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Accent/MaterialDesignColor.Yellow.xaml" />
            </ResourceDictionary.MergedDictionaries>    

    </ResourceDictionary>    
                    
    </Window.Resources>	

    <Border Name="CredentialsPromptOutsideBorder" BorderThickness="1" CornerRadius="17"  Background="Transparent">

        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
               <GradientStop Color="LightBlue" Offset="0"/>
                <GradientStop Color="Lime" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border Name="CredentialsPromptInsideBorder" BorderThickness="5" CornerRadius="15" BorderBrush="Black" Background="{DynamicResource MaterialDesignPaper}">  
                <StackPanel >
                    <TextBlock Text="Enter credentials" FontWeight="Bold" FontSize="16" Margin="20,10,0,15"/>
                    <TextBlock Name="TextBlockEndPoint" Text="Enter your credentials to connect to:" Margin="20,0,0,15" />
                    <TextBox Name="TextBoxUserName" 
                             HorizontalAlignment="Left" 
                             Width="250" 
                             Margin="20,0,0,15" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             CaretBrush="{Binding Color, ElementName=TextBoxUserName, Path=BorderBrush}">
                        <materialDesign:HintAssist.Hint>
                            <TextBlock Name="UserNameHintAssist">User name</TextBlock>
                        </materialDesign:HintAssist.Hint>
                    </TextBox>
                    <PasswordBox Name="TextBoxPassword" 
                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}" 
                                 HorizontalAlignment="Left" 
                                 Width="250" 
                                 Margin="20,0,0,15"
                                 CaretBrush="{Binding Color, ElementName=TextBoxPassword, Path=BorderBrush}"> 
                        <materialDesign:HintAssist.Hint>
                            <TextBlock Name="PasswordHintAssist">Password</TextBlock>
                        </materialDesign:HintAssist.Hint>
                    </PasswordBox>
                    <CheckBox Name="CheckBoxRememberCreds" Content="Remember my credentials" IsChecked="False" Margin="20,0,0,40" ToolTip="Click to save or remove credentials. They are removed at application close." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Name="ButtonOK" Content="OK" Margin="0,0,5,0" Width="150" />
                        <Button Name="ButtonCancel" Content="Cancel" Margin="5,0,0,0" Width="150"/>
                    </StackPanel>
                </StackPanel>
        </Border>
    </Border>

</Window>